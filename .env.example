# Model provider (openrouter is the existing default).
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# For other providers, see docs/architecture.md. Keep real credentials in .env.

# Dependency installation requested by implementation agents.
# deny (default): never install packages.
# allow: install only direct dependencies named in DEPENDENCY_ALLOWLIST.
# always-trust: install all direct registry-semver dependencies declared in package.json.
DEPENDENCY_INSTALL_POLICY=deny

# Required when DEPENDENCY_INSTALL_POLICY=allow. Comma-separated package names.
# DEPENDENCY_ALLOWLIST=express,zod
